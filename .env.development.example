# Development Supabase project: never the production one.
# Copy this file to .env.development (git-ignored) and fill in the values from
# the dev project's dashboard: Project Settings → API Keys. Setup steps:
# supabase/README.md. The local API refuses to start against production.
SUPABASE_URL=https://<dev-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
